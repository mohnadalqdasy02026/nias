NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://nias:nias@localhost:5432/nias

# Auth (Step 4+)
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me

# Security
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=info

# Email (SMTP). Leave SMTP_HOST empty to log emails instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NIAS Academy <no-reply@nias-academy.onrender.com>
CONTACT_NOTIFY_TO=admin@nias-academy.demo
PUBLIC_BASE_URL=https://nias-academy.onrender.com

# Demo seeds. Set to true ONLY to (re)run demo password/academic seeds.
SEED_DEMO=false
DEMO_PASSWORD=Demo@12345