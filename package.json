{
  "name": "nias-academy",
  "version": "1.0.0",
  "private": true,
  "description": "NIAS Academy website rebuild - Node/Express API + React/Vite frontend + PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server"
  }
}